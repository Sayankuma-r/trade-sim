PORT=4000
# MongoDB Atlas (free tier) connection string. Atlas is a replica set, so transactions work.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tradesim
# Local plain MongoDB (not a replica set)? Use mongodb://127.0.0.1:27017/tradesim and set this to false.
MONGO_TRANSACTIONS=true
JWT_SECRET=put-a-long-random-string-here-32-chars-min
ADMIN_EMAIL=admin@tradesim.dev
ADMIN_PASSWORD=choose-a-password
CLIENT_ORIGIN=http://localhost:5173
# Optional: real AI explanations. Leave empty to use the built-in template explanation.
ANTHROPIC_API_KEY=
